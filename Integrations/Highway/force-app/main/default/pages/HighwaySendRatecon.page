<apex:page controller="HighwaySendRateConVFController"
           sidebar="false"
           showHeader="true">

    <apex:form >
        <apex:pageMessages id="msgs" />

        <apex:pageBlock title="Send Rate Confirmation to Highway" id="pb">

            <apex:outputPanel rendered="{!NOT(ISBLANK(message))}" id="msgPanel">
                <div style="{!IF(success,
                    'color: green; font-weight: bold; margin-bottom: 12px;',
                    'color: red; font-weight: bold; margin-bottom: 12px;')}">
                    {!message}
                </div>
            </apex:outputPanel>

            <apex:pageBlockSection columns="1">
                <apex:outputLabel value="Target Email" for="targetEmail" />

                <apex:selectList value="{!selectedTargetEmail}"
                                 size="1"
                                 id="targetEmail">
                    <apex:selectOptions value="{!carrierEmailOptions}" />
                </apex:selectList>

                <apex:outputText value="If no email is selected, the rate confirmation will be sent without targeted_emails." />
            </apex:pageBlockSection>

            <apex:pageBlockButtons location="bottom">
                <apex:commandButton value="Send"
                                    action="{!send}"
                                    rerender="pb,msgs"
                                    status="sendStatus" />

                <apex:commandButton value="Back to Load"
                                    action="{!goBack}"
                                    immediate="true" />
            </apex:pageBlockButtons>

            <apex:actionStatus id="sendStatus">
                <apex:facet name="start">
                    <span style="font-weight:bold;">Sending...</span>
                </apex:facet>
            </apex:actionStatus>

        </apex:pageBlock>
    </apex:form>
</apex:page>