<apex:page standardController="FreightTM__Load__c"
    recordSetVar="loads"
    extensions="AutoFillListController"
    lightningStylesheets="true">

    <apex:form enctype="multipart/form-data">
        <apex:pageMessages />

        <apex:pageBlock title="Send Email Content">
            <apex:pageBlockSection columns="1">

                <apex:inputTextarea value="{!emailContent}"
                    label="Description"
                    rows="8"
                    style="width: 600px;" />

                <apex:outputLabel value="Attachment 1" />
                <apex:inputFile value="{!uploadedFile1}"
                    filename="{!uploadedFile1Name}" />

                <apex:outputLabel value="Attachment 2" />
                <apex:inputFile value="{!uploadedFile2}"
                    filename="{!uploadedFile2Name}" />

            </apex:pageBlockSection>

            <apex:pageBlockButtons >
                <apex:commandButton value="Send"
                    action="{!sendToApi}" />

                <apex:commandButton value="Cancel"
                    action="{!cancel}"
                    immediate="true" />
            </apex:pageBlockButtons>
        </apex:pageBlock>
    </apex:form>
</apex:page>