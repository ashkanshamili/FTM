<apex:page showHeader="false" sidebar="false" standardStylesheets="false" applyHtmlTag="false" applyBodyTag="false" docType="html-5.0" cache="false">
<html>
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Customer Portal</title>
    <style>
        html,body{margin:0;min-height:100%;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;background:#F4F7FB;color:#0B1220}
        .cp-site-shell{min-height:100vh;display:grid;place-items:center;padding:32px;box-sizing:border-box}
        .cp-site-card{width:min(620px,100%);background:#fff;border:1px solid #D9E3EF;border-radius:18px;padding:32px;box-sizing:border-box;box-shadow:0 10px 30px rgba(15,23,42,.08);text-align:center}
        .cp-site-card h1{margin:0 0 12px;font-size:28px} .cp-site-card p{margin:0;color:#475569;line-height:1.6}
        .cp-site-card a{display:inline-block;margin-top:20px;color:#0A74C0;font-weight:700;text-decoration:none}
    </style>
</head>
<body><apex:insert name="body"/></body>
</html>
</apex:page>
