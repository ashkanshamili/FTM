<apex:page controller="LaneQuoteCloneController"
    lightningStylesheets="true"
    showHeader="true"
    sidebar="false"
    docType="html-5.0">

    <apex:form id="cloneForm">

        <apex:pageMessages id="messages"/>

        <apex:actionStatus id="saveStatus">
            <apex:facet name="start">
                <div class="loadingBackdrop">
                    <div class="loadingBox">
                        Creating cloned Lane Quotes...
                    </div>
                </div>
            </apex:facet>
        </apex:actionStatus>

        <apex:pageBlock title="Clone this Lane Quote"
            mode="edit">

            <apex:pageBlockButtons location="top">

                <apex:commandButton value="Create Cloned Lane Quotes"
                    action="{!saveClones}"
                    status="saveStatus"/>

                <apex:commandButton value="Cancel"
                    action="{!cancel}"
                    immediate="true"/>

            </apex:pageBlockButtons>

            <!-- Clone options -->
            <apex:pageBlockSection title="Clone Options"
                columns="1"
                collapsible="false">

                <apex:pageBlockSectionItem >

                    <apex:outputLabel value="Number of Lane Quotes to Create"
                        for="cloneCount"/>

                    <apex:inputText id="cloneCount"
                        value="{!cloneCount}"
                        required="true"
                        html-type="number"
                        html-min="1"
                        html-max="25"/>

                </apex:pageBlockSectionItem>

                <apex:pageBlockSectionItem
                    rendered="{!hasLaneQuoteRecordTypes}">

                    <apex:outputLabel value="Lane Quote Record Type"
                        for="recordType"/>

                    <apex:selectList id="recordType"
                        value="{!selectedRecordTypeId}"
                        size="1"
                        required="true">

                        <apex:selectOptions value="{!laneQuoteRecordTypeOptions}"/>

                    </apex:selectList>

                </apex:pageBlockSectionItem>

            </apex:pageBlockSection>

            <!-- Lane Quote -->
            <apex:pageBlockSection title="Lane Quote Information"
                columns="2"
                collapsible="true">

                <apex:repeat value="{!laneQuoteFields}"
                    var="field">

                    <apex:pageBlockSectionItem >

                        <apex:outputLabel value="{!field.label}"/>

                        <apex:inputField value="{!laneQuoteRecord[field.apiName]}"/>

                    </apex:pageBlockSectionItem>

                </apex:repeat>

            </apex:pageBlockSection>

            <!-- Quote Lines -->
            <apex:pageBlockSection title="Quote Lines"
                columns="1"
                collapsible="true">

                <apex:commandButton value="Add Quote Line"
                    action="{!addQuoteLine}"
                    rerender="quoteLinePanel,messages"/>

                <apex:outputPanel id="quoteLinePanel"
                    layout="block">

                    <apex:variable var="quoteLineIndex"
                        value="{!0}"/>

                    <apex:repeat value="{!quoteLines}"
                        var="row">

                        <div class="childRecord">

                            <div class="childHeader">
                                <span>
                                    Quote Line {!quoteLineIndex + 1}
                                </span>

                                <apex:commandLink value="Remove"
                                    action="{!removeQuoteLine}"
                                    immediate="true"
                                    rerender="quoteLinePanel,messages">

                                    <apex:param value="{!quoteLineIndex}"
                                        assignTo="{!rowIndex}"/>

                                </apex:commandLink>
                            </div>

                            <div class="fieldGrid">

                                <apex:repeat value="{!quoteLineFields}"
                                    var="field">

                                    <div class="fieldContainer">

                                        <apex:outputLabel value="{!field.label}"/>

                                        <apex:inputField value="{!row.record[field.apiName]}"/>

                                    </div>

                                </apex:repeat>

                            </div>

                        </div>

                        <apex:variable var="quoteLineIndex"
                            value="{!quoteLineIndex + 1}"/>

                    </apex:repeat>

                    <apex:outputPanel rendered="{!quoteLines.size = 0}">

                        <div class="emptyMessage">
                            No Quote Lines. Click “Add Quote Line”
                            to create one.
                        </div>

                    </apex:outputPanel>

                </apex:outputPanel>

            </apex:pageBlockSection>

            <!-- Quote Pays -->
            <apex:pageBlockSection title="Quote Pays"
                columns="1"
                collapsible="true">

                <apex:commandButton value="Add Quote Pay"
                    action="{!addQuotePay}"
                    rerender="quotePayPanel,messages"/>

                <apex:outputPanel id="quotePayPanel"
                    layout="block">

                    <apex:variable var="quotePayIndex"
                        value="{!0}"/>

                    <apex:repeat value="{!quotePays}"
                        var="row">

                        <div class="childRecord">

                            <div class="childHeader">
                                <span>
                                    Quote Pay {!quotePayIndex + 1}
                                </span>

                                <apex:commandLink value="Remove"
                                    action="{!removeQuotePay}"
                                    immediate="true"
                                    rerender="quotePayPanel,messages">

                                    <apex:param value="{!quotePayIndex}"
                                        assignTo="{!rowIndex}"/>

                                </apex:commandLink>
                            </div>

                            <div class="fieldGrid">

                                <apex:repeat value="{!quotePayFields}"
                                    var="field">

                                    <div class="fieldContainer">

                                        <apex:outputLabel value="{!field.label}"/>

                                        <apex:inputField value="{!row.record[field.apiName]}"/>

                                    </div>

                                </apex:repeat>

                            </div>

                        </div>

                        <apex:variable var="quotePayIndex"
                            value="{!quotePayIndex + 1}"/>

                    </apex:repeat>

                    <apex:outputPanel rendered="{!quotePays.size = 0}">

                        <div class="emptyMessage">
                            No Quote Pays. Click “Add Quote Pay”
                            to create one.
                        </div>

                    </apex:outputPanel>

                </apex:outputPanel>

            </apex:pageBlockSection>

            <!-- Quote Legs -->
            <apex:pageBlockSection title="Quote Legs"
                columns="1"
                collapsible="true">

                <apex:commandButton value="Add Quote Leg"
                    action="{!addQuoteLeg}"
                    rerender="quoteLegPanel,messages"/>

                <apex:outputPanel id="quoteLegPanel"
                    layout="block">

                    <apex:variable var="quoteLegIndex"
                        value="{!0}"/>

                    <apex:repeat value="{!quoteLegs}"
                        var="row">

                        <div class="childRecord">

                            <div class="childHeader">
                                <span>
                                    Quote Leg {!quoteLegIndex + 1}
                                </span>

                                <apex:commandLink value="Remove"
                                    action="{!removeQuoteLeg}"
                                    immediate="true"
                                    rerender="quoteLegPanel,messages">

                                    <apex:param value="{!quoteLegIndex}"
                                        assignTo="{!rowIndex}"/>

                                </apex:commandLink>
                            </div>

                            <div class="fieldGrid">

                                <apex:repeat value="{!quoteLegFields}"
                                    var="field">

                                    <div class="fieldContainer">

                                        <apex:outputLabel value="{!field.label}"/>

                                        <apex:inputField value="{!row.record[field.apiName]}"/>

                                    </div>

                                </apex:repeat>

                            </div>

                        </div>

                        <apex:variable var="quoteLegIndex"
                            value="{!quoteLegIndex + 1}"/>

                    </apex:repeat>

                    <apex:outputPanel rendered="{!quoteLegs.size = 0}">

                        <div class="emptyMessage">
                            No Quote Legs. Click “Add Quote Leg”
                            to create one.
                        </div>

                    </apex:outputPanel>

                </apex:outputPanel>

            </apex:pageBlockSection>

            <apex:pageBlockButtons location="bottom">

                <apex:commandButton value="Create Cloned Lane Quotes"
                    action="{!saveClones}"
                    status="saveStatus"/>

                <apex:commandButton value="Cancel"
                    action="{!cancel}"
                    immediate="true"/>

            </apex:pageBlockButtons>

        </apex:pageBlock>

    </apex:form>

    <style>
        .childRecord {
            background: #ffffff;
            border: 1px solid #dddbda;
            border-radius: 4px;
            margin: 12px 0;
            padding: 14px;
        }

        .childHeader {
            align-items: center;
            border-bottom: 1px solid #ecebea;
            display: flex;
            font-size: 15px;
            font-weight: 600;
            justify-content: space-between;
            margin-bottom: 14px;
            padding-bottom: 10px;
        }

        .fieldGrid {
            display: grid;
            gap: 14px 24px;
            grid-template-columns:
                repeat(2, minmax(250px, 1fr));
        }

        .fieldContainer {
            min-width: 0;
        }

        .fieldContainer label {
            display: block;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .fieldContainer input,
        .fieldContainer select,
        .fieldContainer textarea {
            box-sizing: border-box;
            max-width: 100%;
            width: 100%;
        }

        .emptyMessage {
            background: #f3f3f3;
            border-radius: 4px;
            margin-top: 10px;
            padding: 14px;
        }

        .loadingBackdrop {
            align-items: center;
            background: rgba(255, 255, 255, 0.65);
            bottom: 0;
            display: flex;
            justify-content: center;
            left: 0;
            position: fixed;
            right: 0;
            top: 0;
            z-index: 99999;
        }

        .loadingBox {
            background: #ffffff;
            border: 1px solid #dddbda;
            border-radius: 5px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.25);
            font-size: 16px;
            font-weight: 600;
            padding: 24px 35px;
        }

        @media only screen and (max-width: 800px) {
            .fieldGrid {
                grid-template-columns: 1fr;
            }
        }
    </style>

</apex:page>